{
  // Cloudflare Workers 배포 설정.
  //
  // 코드가 없는 정적 자산 전용 Worker 다 — dist/ 를 그대로 내보낸다.
  // dist/ 는 저장소에 없고 build.mjs 가 배포할 때마다 만든다(.gitignore 참고).
  //
  // name 은 이미 쓰고 있는 주소와 같아야 한다. 바꾸면 새 주소가 생기고
  // laundry-game.npcsun2.workers.dev 는 옛 판을 그대로 내보낸다.
  //
  // ── Cloudflare 대시보드 설정 (Workers & Pages → 이 Worker → Settings → Build) ──
  //
  //   Build command   : npm run build
  //   Deploy command  : npx wrangler versions upload --assets=./dist
  //   Root directory  : /
  //
  // Build command 를 None 으로 두면 배포가 반드시 깨진다. dist/ 는 저장소에 없고
  // (.gitignore) build.mjs 가 만드는 것이라, 빌드를 건너뛰면 업로드할 폴더 자체가
  // 없어서 wrangler 가 이렇게 멈춘다:
  //   The directory specified by the "--assets" command line argument does not exist:
  //   /opt/buildhome/repo/dist
  //
  // Build command 를 못 넣는 상황이면 Deploy command 를 `npm run deploy` 로 바꿔도
  // 된다 — 그 스크립트가 빌드까지 같이 한다(package.json 참고).
  //
  // 참고: versions upload 는 '판'만 올리고 실서비스 주소로 넘기지 않는다.
  // 프로덕션 브랜치에서 바로 내보내려면 wrangler deploy (= npm run deploy:production).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "laundry-game",
  "compatibility_date": "2026-08-13",
  "assets": {
    "directory": "./dist",

    // 없는 경로는 404 로 둔다. single-page-application 로 두면 안 되는 이유:
    //
    // 이 사이트는 SPA 가 아니다. 러너가 자극 두 종을 **iframe 으로** 불러오는 다중 파일
    // 정적 사이트다(laundry-ad/index.html · game/dist/index.html).
    // SPA 모드는 못 찾은 경로에 index.html 을 200 으로 돌려준다. 그러면
    //   · 자극 경로가 하나라도 어긋나면 iframe 안에 러너가 또 뜬다. 참가자에게는
    //     광고 대신 설문 첫 화면이 보이고, AD_DONE 이 영영 오지 않아 그 블록이 멈춘다.
    //   · 러너가 시작할 때 하는 game/dist 존재 확인(HEAD)이 항상 200 이 되어,
    //     "빌드하세요" 경고가 뜨지 않고 대신 깨진 iframe 이 나온다.
    // 즉 배포 사고가 조용한 오작동으로 바뀐다. 404 로 두면 바로 드러난다.
    "not_found_handling": "none"
  }
}
